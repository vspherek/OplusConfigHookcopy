<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/section_content_padding">


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:maxLines="3"
            android:text="@string/autostart_policy_desc"
            android:textAppearance="@style/TextAppearance.OplusConfigHook.SectionBody" />

        <TextView
            android:id="@+id/tvAutostartSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="@string/autostart_actions_title"
            android:textAppearance="@style/TextAppearance.OplusConfigHook.SectionTitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:orientation="vertical"
            android:padding="@dimen/space_2"
            android:background="?attr/colorSurfaceContainerLow">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApplyAutostart"
                style="@style/Widget.OplusConfigHook.Button.FullWidth"
                android:layout_height="wrap_content"
                android:text="@string/apply_policy" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnImportAutostart"
                style="@style/Widget.OplusConfigHook.Button.OutlinedFullWidth"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/import_txt" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportAutostart"
                style="@style/Widget.OplusConfigHook.Button.OutlinedFullWidth"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/export_policy" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRestoreAutostart"
                style="@style/Widget.OplusConfigHook.Button.OutlinedFullWidth"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:text="@string/restore_default" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditAutostart"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:text="@string/edit_by_checked_apps" />
    </LinearLayout>
</ScrollView>
